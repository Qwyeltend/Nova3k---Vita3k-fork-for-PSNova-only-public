diff --git a/src/dynarmic/interface/nova3k_stats.h b/src/dynarmic/interface/nova3k_stats.h
new file mode 100644
index 00000000..5480436b
--- /dev/null
+++ b/src/dynarmic/interface/nova3k_stats.h
@@ -0,0 +1,14 @@
+// Nova3K: JIT statistics for the emulator's performance monitor (read and reset once per second).
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace Dynarmic::Nova3K {
+inline std::atomic<std::uint64_t> blocks_emitted{0};      // guest basic blocks translated
+inline std::atomic<std::uint64_t> emit_ns{0};             // time spent translating them
+inline std::atomic<std::uint64_t> blocks_invalidated{0};  // translated blocks thrown away
+inline std::atomic<std::uint64_t> fastmem_recompiles{0};  // blocks re-translated with slow memory access after a fault
+inline std::atomic<std::uint64_t> cache_clears{0};        // whole code caches cleared
+inline std::atomic<const char*> prelude_layout{nullptr};   // offsets of the prelude routines (first JIT only)
+}  // namespace Dynarmic::Nova3K
